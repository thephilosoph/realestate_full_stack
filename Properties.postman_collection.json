{
  "info": {
    "name": "Estatein — Features FAQs Testimonials Clients Team",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "feature_id", "value": "1" },
    { "key": "faq_id", "value": "1" },
    { "key": "testimonial_id", "value": "1" },
    { "key": "client_id", "value": "1" },
    { "key": "team_member_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth Login",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const j = pm.response.json();",
            "if (j.token) pm.collectionVariables.set('token', j.token);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@estatein.test\",\"password\":\"password\"}"
        },
        "url": "{{base_url}}/admin/login"
      }
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "List FAQs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/faqs?perPage=15"
          }
        },
        {
          "name": "List Testimonials",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/testimonials?perPage=15"
          }
        },
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/clients?perPage=15"
          }
        },
        {
          "name": "List Team Members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/team-members?perPage=15"
          }
        }
      ]
    },
    {
      "name": "Admin Features",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/features?perPage=50&search="
          }
        },
        {
          "name": "Create",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "const id = j.data?.id ?? j.id;",
                "if (id) pm.collectionVariables.set('feature_id', String(id));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":{\"en\":\"4-Bedroom\",\"ar\":\"4 غرف نوم\"}}"
            },
            "url": "{{base_url}}/admin/features"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":{\"en\":\"3-Bathroom\",\"ar\":\"3 حمامات\"}}"
            },
            "url": "{{base_url}}/admin/features/{{feature_id}}"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/features/{{feature_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin FAQs",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/faqs?perPage=15&is_published="
          }
        },
        {
          "name": "Create",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const j = pm.response.json();",
                "const id = j.data?.id ?? j.id;",
                "if (id) pm.collectionVariables.set('faq_id', String(id));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": {\"en\": \"How do I search?\", \"ar\": \"كيف أبحث؟\"},\n  \"answer\": {\"en\": \"Use the search tools.\", \"ar\": \"استخدم أدوات البحث.\"},\n  \"is_published\": true,\n  \"sort_order\": 1\n}"
            },
            "url": "{{base_url}}/admin/faqs"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"is_published\": false}"
            },
            "url": "{{base_url}}/admin/faqs/{{faq_id}}"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/faqs/{{faq_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin Testimonials",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/testimonials?perPage=15"
          }
        },
        {
          "name": "Create JSON",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\"en\": \"Wade Warren\", \"ar\": \"ويد وارين\"},\n  \"title\": {\"en\": \"Exceptional Service!\", \"ar\": \"خدمة استثنائية!\"},\n  \"body\": {\"en\": \"Outstanding experience.\", \"ar\": \"تجربة رائعة.\"},\n  \"location\": {\"en\": \"USA, California\", \"ar\": \"أمريكا، كاليفورنيا\"},\n  \"rating\": 5,\n  \"is_published\": true\n}"
            },
            "url": "{{base_url}}/admin/testimonials"
          }
        },
        {
          "name": "Create multipart + avatar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name[en]", "value": "John Mans", "type": "text" },
                { "key": "name[ar]", "value": "جون مانز", "type": "text" },
                { "key": "title[en]", "value": "Efficient and Reliable", "type": "text" },
                { "key": "title[ar]", "value": "كفء وموثوق", "type": "text" },
                { "key": "body[en]", "value": "Top-notch service.", "type": "text" },
                { "key": "body[ar]", "value": "خدمة ممتازة.", "type": "text" },
                { "key": "rating", "value": "5", "type": "text" },
                { "key": "is_published", "value": "1", "type": "text" },
                { "key": "avatar", "type": "file", "src": [] }
              ]
            },
            "url": "{{base_url}}/admin/testimonials"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/testimonials/{{testimonial_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin Clients",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/clients"
          }
        },
        {
          "name": "Create multipart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name[en]", "value": "Acme Corp", "type": "text" },
                { "key": "name[ar]", "value": "أكمي", "type": "text" },
                { "key": "website_url", "value": "https://example.com", "type": "text" },
                { "key": "is_published", "value": "1", "type": "text" },
                { "key": "logo", "type": "file", "src": [] }
              ]
            },
            "url": "{{base_url}}/admin/clients"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/clients/{{client_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin Team Members",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/team-members"
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\"en\": \"Sarah Bell\", \"ar\": \"سارة بيل\"},\n  \"role\": {\"en\": \"CEO\", \"ar\": \"المديرة التنفيذية\"},\n  \"bio\": {\"en\": \"Leader in real estate.\", \"ar\": \"قائدة في العقارات.\"},\n  \"is_published\": true\n}"
            },
            "url": "{{base_url}}/admin/team-members"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/admin/team-members/{{team_member_id}}"
          }
        }
      ]
    }
  ]
}